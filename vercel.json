{
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && VITE_SERVERLESS=1 npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": { "maxDuration": 60, "includeFiles": "backend/app/**" }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
