# Live AI (optional). Without keys, agents run their deterministic policies.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Models (change to models your account can use)
SKYOPS_CLAUDE_MODEL=claude-sonnet-5-5
SKYOPS_CLAUDE_FAST_MODEL=claude-haiku-5-5
SKYOPS_OPENAI_MODEL=gpt-5-mini
# auto = use keys if present, offline = force deterministic agents
SKYOPS_AI_MODE=auto
# seconds between agent messages so the audience can follow (0 = as fast as possible)
SKYOPS_DEMO_PACE=0.55
